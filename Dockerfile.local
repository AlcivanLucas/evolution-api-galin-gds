# Local build: same as Dockerfile, but skips "tsc --noEmit" (needs >1.3 GB RAM). Type-check on the host with: npx tsc --noEmit
FROM node:24-alpine AS builder

# Retries: Docker Desktop's DNS is flaky here. Build with ./local-build.sh, which pins hosts with --add-host.
RUN for i in 1 2 3 4 5; do apk update && apk add --no-cache git ffmpeg wget curl bash openssl && exit 0; sleep 5; done; exit 1

LABEL version="2.3.1" description="Api to control whatsapp features through http requests." 
LABEL maintainer="Davidson Gomes" git="https://github.com/DavidsonGomes"
LABEL contact="contato@evolution-api.com"

WORKDIR /evolution

COPY ./package*.json ./
COPY ./tsconfig.json ./
COPY ./tsup.config.ts ./
RUN npm ci --no-audit --no-fund --loglevel=error --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 --fetch-timeout=600000

COPY ./tsup.local.config.ts ./

# Patches after npm ci, so editing a patch does not re-download node_modules.
COPY ./patches ./patches
RUN npx patch-package

COPY ./src ./src
COPY ./public ./public
COPY ./prisma ./prisma
COPY ./manager ./manager
COPY ./.env.example ./.env
COPY ./runWithProvider.js ./

COPY ./Docker ./Docker

RUN chmod +x ./Docker/scripts/* && dos2unix ./Docker/scripts/*

RUN ./Docker/scripts/generate_database.sh

RUN npx tsup --config tsup.local.config.ts

FROM node:24-alpine AS final

# Retries: Docker Desktop's DNS is flaky here. Build with ./local-build.sh, which pins hosts with --add-host.
RUN for i in 1 2 3 4 5; do apk update && apk add --no-cache tzdata ffmpeg bash openssl && exit 0; sleep 5; done; exit 1

ENV TZ=America/Sao_Paulo
ENV DOCKER_ENV=true

WORKDIR /evolution

COPY --from=builder /evolution/package.json ./package.json
COPY --from=builder /evolution/package-lock.json ./package-lock.json

COPY --from=builder /evolution/node_modules ./node_modules
COPY --from=builder /evolution/dist ./dist
COPY --from=builder /evolution/prisma ./prisma
COPY --from=builder /evolution/manager ./manager
COPY --from=builder /evolution/public ./public
COPY --from=builder /evolution/.env ./.env
COPY --from=builder /evolution/Docker ./Docker
COPY --from=builder /evolution/runWithProvider.js ./runWithProvider.js
COPY --from=builder /evolution/tsup.config.ts ./tsup.config.ts

ENV DOCKER_ENV=true

EXPOSE 8080

ENTRYPOINT ["/bin/bash", "-c", ". ./Docker/scripts/deploy_database.sh && npm run start:prod" ]
